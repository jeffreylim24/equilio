# Copy to backend/.env (gitignored). Values match docker-compose.yml; local dev only.

# Used by the Go app (load with: set -a; source .env; set +a).
DATABASE_URL=postgres://equilio:equilio@localhost:5432/equilio?sslmode=disable

# Used by go test (backend/main_test.go). Must name a database ending in _test.
TEST_DATABASE_URL=postgres://equilio:equilio@localhost:5432/equilio_test?sslmode=disable

# Read automatically by the goose CLI when run from backend/.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://equilio:equilio@localhost:5432/equilio?sslmode=disable
GOOSE_MIGRATION_DIR=./migrations

# HTTP server port (defaults to 8080)
PORT=8080